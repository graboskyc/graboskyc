@layout LoginLayout
@page "/Uploader"
@page "/New"
@inject NavigationManager NavigationManager
@inject IMongoCollection<IG> MediaCollection
@using IGApp.Datamodels
@using MongoDB.Driver
@using Azure.Storage
@using Azure.Storage.Blobs

<div class="ctr_bg" style="background-color:#fff;height:220vh !important;"><div class="ctr_ctr_child ctr_bg">
    <h1>Upload a Pic</h1>
    <h2><a href="/Tweet">Tweet Instead</a></h2>

    <div class="row" style="margin-top:30px;">
        <div class="col-3">
            Caption
        </div>
        <div class="col-9">
            <input type="text" @bind="txt_caption" class="form-control" />
        </div>
    </div>

    <div class="row" style="margin-top:30px;">
        <div class="col-3">
            Location
        </div>
        <div class="col-9">
            <input type="text" @bind="txt_loc" class="form-control" />
        </div>
    </div>

    <div class="row" style="margin-top:30px;" >
        <div class="col-3">
            Tags
        </div>
        <div class="col-9">
            <input type="text" @bind="txt_tags" class="form-control" />
        </div>
    </div>
        
    <div class="row" style="margin-top:30px;">
        <div class="col-3"></div>
        <div class="col-6">

                <label class="custom-file-label" for="customFile">@selFileTitle</label>
                <InputFile OnChange="@LoadFiles" class="form-control custom-file-input" id="customFile" />
        
        </div>
        <div class="col-3"></div>
    </div>
    

    <div class="row" style="margin-top:30px;">
        <div class="col-3"></div>
        <div class="col-6">
            @if(!isDone) {
                @if(!isLoading) {
                    <button class="btn btn-gsky btn-lg">Upload</button>
                } else {
                    <button class="btn btn-gsky btn-lg" disabled >
                        <span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span> 
                        Uploading...
                    </button>
                }
            } else {
                <span>DONE!</span>
            }
        </div>
        <div class="col-3"></div>
    </div>


    <br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br>

</div></div>

<br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br>

@code {
    private bool isLoading = false;
    private bool isDone = false;
    private string selFileTitle = "Choose Pic";

    private string uploadName = "";
    private string txt_loc = "";
    private string txt_caption = "";
    private string txt_tags = "";

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        isLoading = true;

        try {
            Guid guid = Guid.NewGuid();
            uploadName = guid.ToString().ToUpper() + ".jpg";

            // upload to azure blob
            string connectionString = Environment.GetEnvironmentVariable("BLOBENDPOINT")!;
            string containerName = "media";
            BlobContainerClient container = new BlobContainerClient(connectionString, containerName);
            BlobClient blob = container.GetBlobClient("fromctr/" + uploadName);

            using var stream = e.File.OpenReadStream(500000000);
            await blob.UploadAsync(stream, overwrite: true);

            // insert into MongoDB
            var tagsList = string.IsNullOrWhiteSpace(txt_tags)
                ? new List<string>()
                : txt_tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

            var ig = new IG
            {
                taken_at = DateTime.UtcNow,
                path = "fromctr/" + uploadName,
                caption = txt_caption,
                location = txt_loc,
                tags = tagsList,
                trigger = $"https://gskywebstore.blob.core.windows.net/media/fromctr/{uploadName}",
                MediaType = "picture"
            };

            await MediaCollection.InsertOneAsync(ig);

            isDone = true;
        } catch (Exception ex) {
            Console.WriteLine(ex.ToString());
        }

        isLoading = false;
    }
}